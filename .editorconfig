root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,psm1,cmd,bat,cs,iss}]
end_of_line = crlf
indent_size = 4

[*.ps1]
indent_size = 2

# gofmt's layout: tabs.
[*.go]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Preserve upstream bytes, including license whitespace.
[{vendor,third_party}/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
