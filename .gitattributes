# Text files are stored with LF in the repository. Windows scripts are checked
# out with CRLF, which Windows PowerShell 5.1 and cmd.exe expect.
* text=auto eol=lf

*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.cs text eol=crlf
*.iss text eol=crlf

*.ico binary
*.png binary
*.gif binary
*.jpg binary
*.exe binary
*.dll binary
