# Everything Net Switch writes while running: your settings, the Windows undo
# record, the engine config, logs and the local session key. Created on first run.
data/
data-test/

# sing-box is downloaded and checked against engine/SHA256SUMS.txt, not committed.
engine/*.exe
engine/*.dll

# A bundled Node.js runtime, added by the release build.
runtime/

# The native helper, built from helper/ by scripts/build-helper.ps1.
helper/bin/

# The tray icon's program, built from lib/tray.cs by scripts/build-tray.ps1.
tray/bin/

# Release build output.
dist/

# Net Switch 1.0 Go builds.
/bin/

node_modules/
*.log
*.pid

# Local design and tooling files.
design/
.impeccable/
PRODUCT.md
